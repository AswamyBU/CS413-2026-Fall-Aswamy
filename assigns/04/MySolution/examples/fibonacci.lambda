# Fibonacci: fix fib(n). if n < 2 then n else fib(n - 1) + fib(n - 2), applied to 15.
# Expected Interpret result: D0Vint(arg1=610)
D0Eapp(
    D0Efix("fib", "n",
        D0Eif0(
            D0Eop2("<", D0Evar("n"), D0Eint(2)),
            D0Evar("n"),                                 # base cases fib(0)=0, fib(1)=1
            D0Eop2("+",
                D0Eapp(D0Evar("fib"), D0Eop2("-", D0Evar("n"), D0Eint(1))),
                D0Eapp(D0Evar("fib"), D0Eop2("-", D0Evar("n"), D0Eint(2)))))),
    D0Eint(15))
